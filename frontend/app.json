{
  "expo": {
    "name": "TeeBox",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "teebox",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teebox.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Attach photos to your round posts",
        "NSCameraUsageDescription": "Attach photos to your round posts",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["teebox"]
          }
        ]
      }
    },
    "android": {
      "package": "com.teebox.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#15803D"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["READ_MEDIA_IMAGES"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [{ "scheme": "teebox" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#132A1C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
